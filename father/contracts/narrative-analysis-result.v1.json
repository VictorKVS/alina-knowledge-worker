{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "father/contracts/narrative-analysis-result.v1.json",
  "title": "ALINA-BOOK Narrative Analysis Result v1",
  "type": "object",
  "required": [
    "case_id",
    "engine",
    "data_mode",
    "entities",
    "events",
    "relations",
    "claims",
    "evidence",
    "hypotheses",
    "unknowns",
    "forecast",
    "provenance"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "object",
      "required": [
        "block",
        "version"
      ],
      "properties": {
        "block": {
          "const": "AU-01"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "data_mode": {
      "enum": [
        "fixture",
        "source_only",
        "hybrid",
        "live"
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "rejected"
            ]
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "forecast": {
      "type": "object",
      "required": [
        "status",
        "predictions"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "generated",
            "backtested"
          ]
        },
        "predictions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "score": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_ids",
        "generated_at"
      ],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_at": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "time": {
          "type": [
            "string",
            "null"
          ]
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "source",
        "type",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "text",
        "epistemic_type",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "epistemic_type": {
          "enum": [
            "fact",
            "claim",
            "opinion",
            "interpretation",
            "hypothesis",
            "prediction",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "supported",
            "contested",
            "unverified",
            "rejected"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "source_id",
        "locator"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "strength": {
          "enum": [
            "primary",
            "strong",
            "supporting",
            "weak",
            "unknown"
          ]
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "supported",
            "rejected",
            "inconclusive"
          ]
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counter_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}